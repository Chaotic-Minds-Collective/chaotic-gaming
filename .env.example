# Server-only URL for the Chaotic Gaming Core API.
# Use HTTPS in hosted environments. Never prefix this with NEXT_PUBLIC_.
CORE_API_BASE_URL=https://core.example.com

# Must exactly match STEAM_OPENID_RETURN_URL configured in Chaotic Gaming Core.
# This is the Steam OpenID callback route; it is not a secret.
STEAM_OPENID_RETURN_URL=https://www.chaoticmindsgaming.com/api/account/link/steam/callback
